{
  "name": "calc-viz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Calculus Visual Engine — a step-through derivation player for calculus concepts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run",
    "shots": "vite build && node tests/e2e/shots.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "katex": "^0.18.0",
    "zustand": "^5.0.0",
    "three": "^0.185.0",
    "@react-three/fiber": "^9.7.0",
    "@react-three/drei": "^10.7.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright": "^1.50.0",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
